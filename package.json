{
  "name": "visor-dvr",
  "productName": "Visor DVR",
  "version": "1.0.0",
  "description": "Visualizador simples para DVR Intelbras/Dahua: grade ao vivo, gravações e recortes.",
  "main": "src/main/main.js",
  "author": "pabloteari <pabloteari@users.noreply.github.com>",
  "homepage": "https://github.com/pabloteari/visor-dvr",
  "repository": "github:pabloteari/visor-dvr",
  "desktopName": "visor-dvr.desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "br.local.visordvr",
    "productName": "Visor DVR",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video",
      "syncDesktopName": true
    },
    "deb": {
      "maintainer": "pabloteari <pabloteari@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
